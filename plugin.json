{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "codex-runners",
  "version": "0.1.0",
  "description": "Monitor GitHub Actions and self-hosted GitLab pipelines from Codex desktop.",
  "author": {
    "name": "cscxj",
    "url": "https://github.com/cscxj"
  },
  "homepage": "https://github.com/cscxj/codex_runners",
  "repository": "https://github.com/cscxj/codex_runners",
  "license": "MIT",
  "keywords": ["codex", "github-actions", "gitlab", "ci", "pipelines"],
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "onboardingSkill": "./skills/onboarding/SKILL.md",
      "interface": {
        "displayName": "Codex Runners",
        "shortDescription": "Monitor repository pipelines",
        "longDescription": "Track running GitHub Actions and GitLab pipelines, open their native pages, and review unread completion or failure events.",
        "developerName": "cscxj",
        "category": "Developer Tools",
        "capabilities": ["Interactive", "Read"],
        "websiteURL": "https://github.com/cscxj/codex_runners",
        "privacyPolicyURL": "https://github.com/cscxj/codex_runners/blob/main/PRIVACY.md",
        "termsOfServiceURL": "https://github.com/cscxj/codex_runners/blob/main/TERMS.md",
        "defaultPrompt": ["@Codex Runners show my running pipelines."],
        "brandColor": "#2563EB",
        "composerIcon": "./assets/icon.svg",
        "logo": "./assets/icon.svg",
        "logoDark": "./assets/icon-dark.svg"
      }
    }
  }
}
