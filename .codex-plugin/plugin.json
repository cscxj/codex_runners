{
  "name": "codex-runners",
  "version": "0.1.0",
  "description": "Monitor GitHub Actions and self-hosted GitLab pipelines from Codex desktop.",
  "author": { "name": "cscxj" },
  "skills": "./skills/",
  "mcpServers": "./.mcp.json",
  "requires_local_executor": true,
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/onboarding/SKILL.md"
    }
